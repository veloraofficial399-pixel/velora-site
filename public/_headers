# Cloudflare static assets: caching rules.
# Vite gives these files a content hash in their names, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Preview videos/posters are requested with ?v=<build id>, so a new deploy always gets fresh ones.
/previews/*
  Cache-Control: public, max-age=604800

/guide/*
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=86400
